#include <vector>
#include <algorithm>
#include <unordered_map>

class Solution {
public:
    std::vector<int> countServers(int n, std::vector<std::vector<int>>& logs, int x, std::vector<int>& queries) {
        int m = queries.size();
        // Store queries with their original indices: {query_time, original_index}
        std::vector<std::pair<int, int>> sorted_queries(m);
        for (int i = 0; i < m; ++i) {
            sorted_queries[i] = {queries[i], i};
        }
        
        // Sort queries by time
        std::sort(sorted_queries.begin(), sorted_queries.end());
        // Sort logs by time
        std::sort(logs.begin(), logs.end(), [](const std::vector<int>& a, const std::vector<int>& b) {
            return a[1] < b[1];
        });
        
        std::vector<int> ans(m);
        std::unordered_map<int, int> server_counts;
        
        int left = 0, right = 0;
        int num_logs = logs.size();
        
        for (const auto& q : sorted_queries) {
            int q_time = q.first;
            int q_idx = q.second;
            
            int window_start = q_time - x;
            int window_end = q_time;
            
            // Add logs that fall within the right boundary (<= window_end)
            while (right < num_logs && logs[right][1] <= window_end) {
                server_counts[logs[right][0]]++;
                right++;
            }
            
            // Remove logs that fall outside the left boundary (< window_start)
            while (left < num_logs && logs[left][1] < window_start) {
                server_counts[logs[left][0]]--;
                if (server_counts[logs[left][0]] == 0) {
                    server_counts.erase(logs[left][0]);
                }
                left++;
            }
            
            // Total servers minus servers with at least 1 request = zero-request servers
            ans[q_idx] = n - server_counts.size();
        }
        
        return ans;
    }
};
