#include <vector>
#include <algorithm>

class Solution {
public:
    int firstStableIndex(std::vector<int>& nums, int k) {
        int n = nums.size();
        
        // leftMax[i] stores max(nums[0..i])
        std::vector<int> leftMax(n);
        leftMax[0] = nums[0];
        for (int i = 1; i < n; ++i) {
            leftMax[i] = std::max(leftMax[i - 1], nums[i]);
        }
        
        // rightMin[i] stores min(nums[i..n-1])
        std::vector<int> rightMin(n);
        rightMin[n - 1] = nums[n - 1];
        for (int i = n - 2; i >= 0; --i) {
            rightMin[i] = std::min(rightMin[i + 1], nums[i]);
        }
        
        // Find the first index where leftMax[i] - rightMin[i] <= k
        for (int i = 0; i < n; ++i) {
            if (leftMax[i] - rightMin[i] <= k) {
                return i;
            }
        }
        
        return -1;
    }
};
