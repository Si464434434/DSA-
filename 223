class Solution {
public:
    int minInsertions(string s) {
        int insertions = 0;
        int openBrackets = 0;
        
        for (int i = 0; i < s.length(); ++i) {
            if (s[i] == '(') {
                openBrackets++;
            } else {
                // It's a closing parenthesis ')'
                // Check if the next character is also ')'
                if (i + 1 < s.length() && s[i + 1] == ')') {
                    i++; // Skip the next ')' as they come in pairs '))'
                } else {
                    // Only one ')' found, we need to insert one more ')'
                    insertions++;
                }
                
                // Match with an open bracket if available, otherwise insert an opening bracket '('
                if (openBrackets > 0) {
                    openBrackets--;
                } else {
                    insertions++;
                }
            }
        }
        
        // Each remaining unmatched opening bracket '(' needs two closing parentheses '))'
        insertions += openBrackets * 2;
        
        return insertions;
    }
};
