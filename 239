};
class Solution {
public:
    bool stoneGameIX(vector<int>& stones) {
        int cnt[3] = {0};
        for (int stone : stones) {
            cnt[stone % 3]++;
        }
        
        // If count of multiples of 3 is even, Alice wins if both count[1] and count[2] are non-zero.
        // If count of multiples of 3 is odd, Alice wins if |count[1] - count[2]| > 2.
        if (cnt[0] % 2 == 0) {
            return cnt[1] > 0 && cnt[2] > 0;
        }
        return abs(cnt[1] - cnt[2]) > 2;
    }
};
