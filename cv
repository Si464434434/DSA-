#include <vector>

class ProductOfNumbers {
    std::vector<int> prefix;

public:
    ProductOfNumbers() {
        prefix.push_back(1);
    }

    void add(int num) {
        if (num == 0) {
            // Reset prefix products because any product crossing 0 becomes 0
            prefix.clear();
            prefix.push_back(1);
        } else {
            prefix.push_back(prefix.back() * num);
        }
    }

    int getProduct(int k) {
        int n = static_cast<int>(prefix.size());
        // If fewer than k non-zero elements exist since the last 0, the product is 0
        if (k >= n) {
            return 0;
        }
        return prefix[n - 1] / prefix[n - 1 - k];
    }
};
