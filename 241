class Solution {
public:
    string compress(string s) {
        int n = s.size();

        // LPS / Prefix Function
        vector<int> lps(n, 0);

        for (int i = 1; i < n; i++) {
            int j = lps[i - 1];

            while (j > 0 && s[i] != s[j]) {
                j = lps[j - 1];
            }

            if (s[i] == s[j]) {
                j++;
            }

            lps[i] = j;
        }

        string ans;

        int i = n - 1;

        while (i >= 0) {
            // Only odd length can be split into two equal halves
            if (i % 2 == 1) {

                int len = i + 1;
                int border = lps[i];

                // Check whether first half = second half
                // and compression is valid
                if (border >= len / 2 &&
                    len % (2 * (len - border)) == 0) {

                    ans += '*';

                    // Move to the middle of the string
                    i = i / 2 + 1;
                }
                else {
                    ans += s[i];
                }
            }
            else {
                ans += s[i];
            }

            i--;
        }

        reverse(ans.begin(), ans.end());

        return ans;
    }
};
