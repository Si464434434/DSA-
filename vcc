class Solution {
public:
    long long minimumCost(long long cost1, long long cost2, long long costBoth, long long need1, long long need2) {
        long long totalCost = 0;
        
        // 1. Cover the overlapping requirement
        long long common = min(need1, need2);
        totalCost += common * min(costBoth, cost1 + cost2);
        
        need1 -= common;
        need2 -= common;
        
        // 2. Cover the remaining requirement for type 1
        if (need1 > 0) {
            totalCost += need1 * min(costBoth, cost1);
        }
        
        // 3. Cover the remaining requirement for type 2
        if (need2 > 0) {
            totalCost += need2 * min(costBoth, cost2);
        }
        
        return totalCost;
    }
};
