#include <iostream>
#include <string>
#include <vector>
#include <set>
#include <algorithm>

class Solution {
public:
    std::vector<std::string> braceExpansionII(std::string expression) {
        std::set<std::string> unique_words = parse(expression);
        return std::vector<std::string>(unique_words.begin(), unique_words.end());
    }

private:
    std::set<std::string> parse(const std::string& s) {
        if (s.find('{') == std::string::npos) {
            return {s};
        }

        int level = 0;
        int start = -1;
        for (int i = 0; i < s.length(); ++i) {
            if (s[i] == '{') {
                if (level == 0) {
                    start = i;
                }
                level++;
            } else if (s[i] == '}') {
                level--;
                if (level == 0) {
                    int end = i;
                    std::string prefix = s.substr(0, start);
                    std::string middle = s.substr(start + 1, end - start - 1);
                    std::string suffix = s.substr(end + 1);

                    // Split middle by comma at the top level of this block
                    std::vector<std::string> parts;
                    std::string curr = "";
                    int lvl = 0;
                    for (char c : middle) {
                        if (c == '{') {
                            lvl++;
                            curr += c;
                        } else if (c == '}') {
                            lvl--;
                            curr += c;
                        } else if (c == ',' && lvl == 0) {
                            parts.push_back(curr);
                            curr = "";
                        } else {
                            curr += c;
                        }
                    }
                    parts.push_back(curr);

                    // Evaluate union of parts inside the brace
                    std::set<std::string> union_set;
                    for (const std::string& p : parts) {
                        std::set<std::string> sub = parse(p);
                        union_set.insert(sub.begin(), sub.end());
                    }

                    // Reconstruct the expression and recursively parse
                    std::set<std::string> res;
                    std::set<std::string> pre_set = parse(prefix);
                    std::set<std::string> suf_set = parse(suffix);

                    for (const std::string& pre : pre_set) {
                        for (const std::string& mid : union_set) {
                            for (const std::string& suf : suf_set) {
                                std::set<std::string> combined = parse(pre + mid + suf);
                                res.insert(combined.begin(), combined.end());
                            }
                        }
                    }
                    return res;
                }
            }
        }
        return {s};
    }
};
