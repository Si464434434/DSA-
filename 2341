class Solution {
public:
    int missingInteger(vector<int>& nums) {
        // Step 1: Find the sum of the longest sequential prefix
        int sum = nums[0];
        for (int i = 1; i < nums.size(); i++) {
            if (nums[i] == nums[i - 1] + 1) {
                sum += nums[i];
            } else {
                break;
            }
        }
        
        // Step 2: Use a hash set to store all elements for O(1) lookups
        unordered_set<int> present(nums.begin(), nums.end());
        
        // Step 3: Find the smallest integer >= sum that is not in the array
        int x = sum;
        while (present.count(x)) {
            x++;
        }
        
        return x;
    }
};
