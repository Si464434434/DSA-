class Solution {
public:
    bool findSafeWalk(vector<vector<int>>& grid, int health) {
        int m = grid.size();
        int n = grid[0].size();
        
        // min_lost[i][j] stores the minimum health lost to reach (i, j)
        vector<vector<int>> min_lost(m, vector<int>(n, INT_MAX));
        
        // Use a deque for 0-1 BFS
        deque<pair<int, int>> dq;
        
        int start_cost = grid[0][0];
        if (start_cost >= health) return false;
        
        min_lost[0][0] = start_cost;
        dq.push_back({0, 0});
        
        int dr[] = {0, 0, 1, -1};
        int dc[] = {1, -1, 0, 0};
        
        while (!dq.empty()) {
            auto [r, c] = dq.front();
            dq.pop_front();
            
            for (int i = 0; i < 4; ++i) {
                int nr = r + dr[i];
                int nc = c + dc[i];
                
                if (nr >= 0 && nr < m && nc >= 0 && nc < n) {
                    int new_cost = min_lost[r][c] + grid[nr][nc];
                    
                    if (new_cost < min_lost[nr][nc]) {
                        min_lost[nr][nc] = new_cost;
                        
                        // If cell is 0, add to front (weight 0), else back (weight 1)
                        if (grid[nr][nc] == 0) {
                            dq.push_front({nr, nc});
                        } else {
                            dq.push_back({nr, nc});
                        }
                    }
                }
            }
        }
        
        return (health - min_lost[m - 1][n - 1] > 0);
    }
};
