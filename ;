class Solution:

  def minMoves(self, nums: List[int]) -> int:
    # Incrementing n - 1 elements by 1 is mathematically equivalent
    # to decrementing 1 element by 1 relative to the others.
    # Thus, the minimum moves required equals the sum of differences
    # between each element and the minimum element in the array.
    min_val = min(nums)
    return sum(x - min_val for x in nums)
