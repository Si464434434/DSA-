#include <vector>
#include <numeric>

class Solution {
    long long MOD = 1e9 + 7;
    std::vector<std::vector<long long>> table;

    // Helper to compute combinations (n choose k) using Pascal's Triangle
    long long combination(int n, int k) {
        if (k > n || k < 0) return 0;
        if (k == 0 || k == n) return 1;
        if (table[n][k] != -1) return table[n][k];
        return table[n][k] = (combination(n - 1, k - 1) + combination(n - 1, k)) % MOD;
    }

    long long dfs(const std::vector<int>& nums) {
        int n = nums.size();
        if (n <= 2) return 1;

        int root = nums[0];
        std::vector<int> left, right;
        for (int i = 1; i < n; ++i) {
            if (nums[i] < root) left.push_back(nums[i]);
            else right.push_back(nums[i]);
        }

        long long left_ways = dfs(left);
        long long right_ways = dfs(right);

        // Ways to interleave left and right subtree elements while preserving relative order
        long long ways = combination(left.size() + right.size(), left.size());
        
        // Multiply by combinations and modulo
        ways = (ways * left_ways) % MOD;
        ways = (ways * right_ways) % MOD;

        return ways;
    }

public:
    int numOfWays(std::vector<int>& nums) {
        int n = nums.size();
        // Initialize memoization table for combinations up to size n
        table = std::vector<std::vector<long long>>(n + 1, std::vector<long long>(n + 1, -1));

        // Subtract 1 to exclude the original array ordering itself
        return (dfs(nums) - 1 + MOD) % MOD;
    }
};
