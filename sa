#include <vector>
#include <unordered_map>
#include <cstdint>

using namespace std;

class Solution {
private:
    static constexpr uint64_t MOD1 = 1000000007ULL;
    static constexpr uint64_t MOD2 = 1000000009ULL;
    static constexpr uint64_t BASE1 = 100003ULL;
    static constexpr uint64_t BASE2 = 100019ULL;

    struct PairHash {
        size_t operator()(const pair<uint64_t, uint64_t>& p) const noexcept {
            uint64_t h = p.first ^ (p.second + 0x9e3779b97f4a7c15ULL + (p.first << 6) + (p.first >> 2));
            return static_cast<size_t>(h);
        }
    };

    bool hasUniqueOfLength(
        int len,
        const vector<uint64_t>& p1,
        const vector<uint64_t>& p2,
        const vector<uint64_t>& h1,
        const vector<uint64_t>& h2
    ) const {
        int n = static_cast<int>(h1.size()) - 1;
        unordered_map<pair<uint64_t, uint64_t>, int, PairHash> freq;
        freq.reserve(static_cast<size_t>(n - len + 1) * 2);

        for (int i = 0; i + len <= n; ++i) {
            int j = i + len;
            uint64_t sub1 = (h1[j] + MOD1 - (h1[i] * p1[len]) % MOD1) % MOD1;
            uint64_t sub2 = (h2[j] + MOD2 - (h2[i] * p2[len]) % MOD2) % MOD2;
            ++freq[{sub1, sub2}];
        }

        for (const auto& [_, count] : freq) {
            if (count == 1) {
                return true;
            }
        }
        return false;
    }

public:
    int smallestUniqueSubarray(vector<int>& nums) {
        int n = static_cast<int>(nums.size());
        vector<uint64_t> p1(n + 1, 1), p2(n + 1, 1);
        vector<uint64_t> h1(n + 1, 0), h2(n + 1, 0);

        for (int i = 0; i < n; ++i) {
            uint64_t val = static_cast<uint64_t>(nums[i]);
            p1[i + 1] = (p1[i] * BASE1) % MOD1;
            p2[i + 1] = (p2[i] * BASE2) % MOD2;
            h1[i + 1] = (h1[i] * BASE1 + val) % MOD1;
            h2[i + 1] = (h2[i] * BASE2 + val) % MOD2;
        }

        int lo = 1, hi = n, ans = n;
        while (lo <= hi) {
            int mid = lo + (hi - lo) / 2;
            if (hasUniqueOfLength(mid, p1, p2, h1, h2)) {
                ans = mid;
                hi = mid - 1;
            } else {
                lo = mid + 1;
            }
        }
        return ans;
    }
};
