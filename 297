class Solution {
public:
    long long maxAlternatingSum(vector<int>& nums) {
        int n = nums.size();
        vector<long long> squared(n);
        
        for (int i = 0; i < n; ++i) {
            squared[i] = (long long)nums[i] * nums[i];
        }
        
        // Sort the squares in ascending order
        sort(squared.begin(), squared.end());
        
        long long maxScore = 0;
        int half = n / 2;
        
        // Subtract the smaller half and add the larger half
        for (int i = 0; i < n; ++i) {
            if (i < half) {
                maxScore -= squared[i];
            } else {
                maxScore += squared[i];
            }
        }
        
        return maxScore;
    }
};
