class Solution {
public:
    int largestSubsquare(vector<vector<char>>& mat) {
        int n = mat.size();
        
        vector<vector<int>> hor(n, vector<int>(n, 0));
        vector<vector<int>> ver(n, vector<int>(n, 0));
        
        int maxLen = 0;
        
        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {
                if (mat[i][j] == 'X') {
                    hor[i][j] = (j == 0) ? 1 : hor[i][j - 1] + 1;
                    ver[i][j] = (i == 0) ? 1 : ver[i - 1][j] + 1;
                }
            }
        }
        
        for (int i = n - 1; i >= 0; i--) {
            for (int j = n - 1; j >= 0; j--) {
                int small = min(hor[i][j], ver[i][j]);
                
                while (small > maxLen) {
                    int r = i - small + 1;
                    int c = j - small + 1;
                    
                    if (ver[i][c] >= small && hor[r][j] >= small) {
                        maxLen = small;
                        break;
                    }
                    small--;
                }
            }
        }
        
        return maxLen;
    }
};
