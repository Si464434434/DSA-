211#include <string>
#include <vector>
#include <stack>

class Solution {
public:
    std::string smallestSubsequence(std::string s) {
        std::vector<int> count(26, 0);
        std::vector<bool> inStack(26, false);
        std::stack<char> st;

        // Count frequency of each character
        for (char c : s) {
            count[c - 'a']++;
        }

        for (char c : s) {
            count[c - 'a']--;

            // If character is already in the result stack, skip it
            if (inStack[c - 'a']) continue;

            // Maintain monotonic stack:
            // Remove top if it's larger than current and will appear later
            while (!st.empty() && st.top() > c && count[st.top() - 'a'] > 0) {
                inStack[st.top() - 'a'] = false;
                st.pop();
            }

            // Add current character
            st.push(c);
            inStack[c - 'a'] = true;
        }

        // Construct the string from the stack
        std::string result = "";
        while (!st.empty()) {
            result = st.top() + result;
            st.pop();
        }
        return result;
    }
};
