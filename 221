#include <bits/stdc++.h>
using namespace std;

bool bpm(int u, vector<vector<int>> &adj, vector<int> &matchR, vector<int> &seen) {
    for (int v : adj[u]) {
        if (!seen[v]) {
            seen[v] = 1;
            if (matchR[v] < 0 || bpm(matchR[v], adj, matchR, seen)) {
                matchR[v] = u;
                return true;
            }
        }
    }
    return false;
}

void solve() {
    int N, K;
    if (!(cin >> N >> K)) return;
    
    vector<int> val(N + 1);
    for (int i = 1; i <= N; i++) {
        cin >> val[i];
    }
    
    // Build the DAG
    // Problem i can precede problem j if:
    // 1. i < j (difficulty level i < difficulty level j)
    // 2. abs(val[i] - val[j]) >= K
    vector<vector<int>> adj(N + 1);
    for (int i = 1; i <= N; i++) {
        for (int j = i + 1; j <= N; j++) {
            if (abs(val[i] - val[j]) >= K) {
                adj[i].push_back(j);
            }
        }
    }
    
    // matchR[v] stores the vertex mapped to v in the right partition (-1 if unmatched)
    vector<int> matchR(N + 1, -1);
    int matchCount = 0;
    
    for (int i = 1; i <= N; i++) {
        vector<int> seen(N + 1, 0);
        if (bpm(i, adj, matchR, seen)) {
            matchCount++;
        }
    }
    
    // Minimum days required = Total problems - Maximum Bipartite Matching
    cout << N - matchCount << "\n";
}

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    int T;
    if (cin >> T) {
        while (T--) {
            solve();
        }
    }
    return 0;
}
