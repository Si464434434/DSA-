#include <vector>

class Solution {
private:
    long long dfs(int r, int c, std::vector<std::vector<int>>& grid) {
        int m = grid.size();
        int n = grid[0].size();
        
        // Out of bounds or water (0) or already visited
        if (r < 0 || r >= m || c < 0 || c >= n || grid[r][c] == 0) {
            return 0;
        }
        
        long long current_val = grid[r][c];
        grid[r][c] = 0; // Mark as visited by setting to 0
        
        // Traverse 4 directions
        current_val += dfs(r + 1, c, grid);
        current_val += dfs(r - 1, c, grid);
        current_val += dfs(r, c + 1, grid);
        current_val += dfs(r, c - 1, grid);
        
        return current_val;
    }

public:
    int countIslands(std::vector<std::vector<int>>& grid, int k) {
        int m = grid.size();
        int n = grid[0].size();
        int valid_island_count = 0;
        
        for (int i = 0; i < m; ++i) {
            for (int j = 0; j < n; ++j) {
                if (grid[i][j] > 0) {
                    long long total_value = dfs(i, j, grid);
                    if (total_value % k == 0) {
                        valid_island_count++;
                    }
                }
            }
        }
        
        return valid_island_count;
    }
};
