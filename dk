class Solution {
  public:
    int subarrayXor(vector<int>& arr) {
        int n = arr.size();
        
        // If the size of the array is even, every element 
        // appears an even number of times across all subarrays.
        if (n % 2 == 0) {
            return 0;
        }
        
        int ans = 0;
        // If n is odd, elements at even indices (0, 2, 4, ...) 
        // appear an odd number of times.
        for (int i = 0; i < n; i += 2) {
            ans ^= arr[i];
        }
        
        return ans;
    }
};
