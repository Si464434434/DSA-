206 class Solution {
public:
    int subsequencePairCount(vector<int>& nums) {
        int n = nums.size();
        int MOD = 1e9 + 7;
        // dp[g1][g2] stores count of subsequence pairs with GCDs g1 and g2
        vector<vector<int>> dp(201, vector<int>(201, 0));
        dp[0][0] = 1;

        for (int x : nums) {
            // Traverse backwards or use a temp table to avoid using 
            // the same element multiple times for the same pair
            vector<vector<int>> next_dp = dp;
            for (int g1 = 0; g1 <= 200; ++g1) {
                for (int g2 = 0; g2 <= 200; ++g2) {
                    if (dp[g1][g2] == 0) continue;
                    
                    // Option 1: Add to seq1
                    int ng1 = (g1 == 0) ? x : std::gcd(g1, x);
                    next_dp[ng1][g2] = (next_dp[ng1][g2] + dp[g1][g2]) % MOD;
                    
                    // Option 2: Add to seq2
                    int ng2 = (g2 == 0) ? x : std::gcd(g2, x);
                    next_dp[g1][ng2] = (next_dp[g1][ng2] + dp[g1][g2]) % MOD;
                }
            }
            dp = next_dp;
        }

        int result = 0;
        for (int i = 1; i <= 200; ++i) {
            result = (result + dp[i][i]) % MOD;
        }
        return result;
    }
};
