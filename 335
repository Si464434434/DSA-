3#include <algorithm>
#include <unordered_map>
#include <vector>

using namespace std;

class Solution {
public:
    int maxSelectedElements(vector<int>& nums) {
        sort(nums.begin(), nums.end());
        
        unordered_map<int, int> dp;
        int ans = 1;
        
        for (int x : nums) {
            // Option 1: Increment x to (x + 1), extending a sequence ending at x
            dp[x + 1] = dp[x] + 1;
            ans = max(ans, dp[x + 1]);
            
            // Option 2: Keep x as x, extending a sequence ending at (x - 1)
            dp[x] = dp[x - 1] + 1;
            ans = max(ans, dp[x]);
        }
        
        return ans;
    }
};
