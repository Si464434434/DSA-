 #include <vector>
#include <unordered_map>

using namespace std;

class Solution {
    long long MOD = 1e9 + 7;
    vector<long long> tree_sq, tree_lin, lazy;

    void push(int node, int l, int r) {
        if (lazy[node] != 0) {
            int mid = (l + r) / 2;
            apply(2 * node, l, mid, lazy[node]);
            apply(2 * node + 1, mid + 1, r, lazy[node]);
            lazy[node] = 0;
        }
    }

    void apply(int node, int l, int r, long long val) {
        long long len = (r - l + 1);
        // sum_sq_new = sum_sq_old + 2 * val * sum_lin + val^2 * len
        tree_sq[node] = (tree_sq[node] + 2 * val * tree_lin[node] + val * val * len) % MOD;
        // sum_lin_new = sum_lin_old + val * len
        tree_lin[node] = (tree_lin[node] + val * len) % MOD;
        lazy[node] = (lazy[node] + val) % MOD;
    }

    void update(int node, int l, int r, int ql, int qr, long long val) {
        if (ql > r || qr < l) return;
        if (ql <= l && r <= qr) {
            apply(node, l, r, val);
            return;
        }
        push(node, l, r);
        int mid = (l + r) / 2;
        update(2 * node, l, mid, ql, qr, val);
        update(2 * node + 1, mid + 1, r, ql, qr, val);
        tree_sq[node] = (tree_sq[2 * node] + tree_sq[2 * node + 1]) % MOD;
        tree_lin[node] = (tree_lin[2 * node] + tree_lin[2 * node + 1]) % MOD;
    }

    long long query(int node, int l, int r, int ql, int qr) {
        if (ql > r || qr < l) return 0;
        if (ql <= l && r <= qr) return tree_sq[node];
        push(node, l, r);
        int mid = (l + r) / 2;
        return (query(2 * node, l, mid, ql, qr) + query(2 * node + 1, mid + 1, r, ql, qr)) % MOD;
    }

public:
    int sumCounts(vector<int>& nums) {
        int n = nums.size();
        tree_sq.assign(4 * n, 0);
        tree_lin.assign(4 * n, 0);
        lazy.assign(4 * n, 0);

        unordered_map<int, int> last_pos;
        long long total_sum = 0;

        for (int j = 0; j < n; ++j) {
            int prev = last_pos.count(nums[j]) ? last_pos[nums[j]] + 1 : 0;
            last_pos[nums[j]] = j;

            // Range update for distinct count increases on range [prev, j]
            update(1, 0, n - 1, prev, j, 1);

            // Query the sum of squares for all starting points from 0 to j ending at current index j
            long long sum_at_j = query(1, 0, n - 1, 0, j);
            total_sum = (total_sum + sum_at_j) % MOD;
        }

        return total_sum;
    }
};
