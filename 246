#include <vector>
#include <queue>

using namespace std;

class Solution {
public:
    int numberOfCells(int r, int c, int u, int d, vector<vector<char>> &mat) {
        int n = mat.size();
        int m = mat[0].size();
        
        if (mat[r][c] == '#') return 0;
        
        // visited[i][j] will store the max 'u' and 'd' we've had when reaching (i, j)
        vector<vector<pair<int, int>>> visited(n, vector<pair<int, int>>(m, {-1, -1}));
        
        queue<vector<int>> q;
        q.push({r, c, u, d});
        visited[r][c] = {u, d};
        
        int count = 0;
        
        // Keep track of cells that have already been counted in the total answer
        vector<vector<bool>> counted(n, vector<bool>(m, false));
        
        int dr[] = {-1, 1, 0, 0};
        int dc[] = {0, 0, -1, 1};
        
        while (!q.empty()) {
            auto curr = q.front();
            q.pop();
            
            int cr = curr[0];
            int cc = curr[1];
            int cu = curr[2];
            int cd = curr[3];
            
            // Count each distinct cell only once
            if (!counted[cr][cc]) {
                counted[cr][cc] = true;
                count++;
            }
            
            for (int i = 0; i < 4; i++) {
                int nr = cr + dr[i];
                int nc = cc + dc[i];
                
                if (nr >= 0 && nr < n && nc >= 0 && nc < m && mat[nr][nc] != '#') {
                    int nu = cu;
                    int nd = cd;
                    
                    if (i == 0) nu--;      // Upward move
                    else if (i == 1) nd--; // Downward move
                    
                    if (nu >= 0 && nd >= 0) {
                        auto &v = visited[nr][nc];
                        // Push to queue if we find a path with strictly better 'u' or 'd' budget
                        if (nu > v.first || nd > v.second) {
                            v.first = max(v.first, nu);
                            v.second = max(v.second, nd);
                            q.push({nr, nc, nu, nd});
                        }
                    }
                }
            }
        }
        
        return count;
    }
};
