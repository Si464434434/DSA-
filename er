class Solution {
public:
    int minMoves2(vector<int>& nums) {
        // Sort the array to find the median
        sort(nums.begin(), nums.end());
        
        int median = nums[nums.size() / 2];
        int moves = 0;
        
        // Calculate the total absolute difference from the median
        for (int num : nums) {
            moves += abs(num - median);
        }
        
        return moves;
    }
};
