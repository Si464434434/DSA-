class Solution {
public:
    int minAddToMakeValid(string s) {
        int open_brackets = 0; // Counts unmatched '('
        int mismatches = 0;    // Counts insertions needed for unmatched ')'

        for (char c : s) {
            if (c == '(') {
                open_brackets++;
            } else { // c == ')'
                if (open_brackets > 0) {
                    open_brackets--; // Matched with a previous '('
                } else {
                    mismatches++;    // Unmatched ')' requires an opening parenthesis
                }
            }
        }

        // Total additions needed = unmatched ')' + unmatched '('
        return mismatches + open_brackets;
    }
};
