 class Solution {
public:
    int sumDiffPairs(vector<int>& arr, int k) {
        // Sort the array in descending order
        sort(arr.begin(), arr.end(), greater<int>());
        
        int n = arr.size();
        int maxSum = 0;
        
        for (int i = 0; i < n - 1; ) {
            // Check if pair difference is less than k
            if (arr[i] - arr[i + 1] < k) {
                maxSum += (arr[i] + arr[i + 1]);
                // Move past both elements of the pair
                i += 2;
            } else {
                // Cannot pair arr[i] with arr[i+1], move to next
                i++;
            }
        }
        
        return maxSum;
    }
};
