 class Solution {
public:
    vector<bool> getResults(vector<vector<int>>& queries) {
        int mx = 0;

        for (auto &q : queries) {
            mx = max(mx, q[1]);
        }

        set<int> obs;
        obs.insert(0);
        obs.insert(mx + 1);

        vector<int> seg(mx + 2, 0);

        for (auto &q : queries) {
            if (q[0] == 1) {
                obs.insert(q[1]);
            }
        }

        int n = mx + 2;

        vector<int> tree(4 * n, 0);

        auto update = [&](auto &&self, int node, int l, int r,
                          int idx, int val) -> void {
            if (l == r) {
                tree[node] = val;
                return;
            }

            int mid = (l + r) >> 1;

            if (idx <= mid)
                self(self, node * 2, l, mid, idx, val);
            else
                self(self, node * 2 + 1, mid + 1, r, idx, val);

            tree[node] = max(tree[node * 2], tree[node * 2 + 1]);
        };

        auto query = [&](auto &&self, int node, int l, int r,
                         int ql, int qr) -> int {
            if (ql > r || qr < l) return 0;

            if (ql <= l && r <= qr) return tree[node];

            int mid = (l + r) >> 1;

            return max(
                self(self, node * 2, l, mid, ql, qr),
                self(self, node * 2 + 1, mid + 1, r, ql, qr)
            );
        };

        vector<int> pos(obs.begin(), obs.end());

        for (int i = 1; i < (int)pos.size(); i++) {
            update(update, 1, 0, n - 1,
                   pos[i], pos[i] - pos[i - 1]);
        }

        vector<bool> ans;

        for (int i = (int)queries.size() - 1; i >= 0; i--) {

            auto &q = queries[i];

            if (q[0] == 2) {

                int x = q[1];
                int sz = q[2];

                auto it = obs.upper_bound(x);

                int r = *it;
                int l = *prev(it);

                int best = query(query, 1, 0, n - 1, 0, x);

                best = max(best, x - l);

                ans.push_back(best >= sz);

            } else {

                int x = q[1];

                auto it = obs.find(x);

                int r = *next(it);
                int l = *prev(it);

                update(update, 1, 0, n - 1, r, r - l);

                obs.erase(it);
            }
        }

        reverse(ans.begin(), ans.end());

        return ans;
    }
};
