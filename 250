#include <string>
#include <vector>
#include <algorithm>

using namespace std;

class Solution {
public:
    string lexGreaterPermutation(string s, string target) {
        int n = s.length();
        
        // Count frequencies of each character in s
        vector<int> count(26, 0);
        for (char c : s) {
            count[c - 'a']++;
        }

        // Try to match target prefix as far as possible (up to length len)
        for (int len = n - 1; len >= 0; --len) {
            // Check if target[0...len-1] can be constructed using available characters in s
            vector<int> temp_count = count;
            bool possible = true;

            for (int i = 0; i < len; ++i) {
                if (--temp_count[target[i] - 'a'] < 0) {
                    possible = false;
                    break;
                }
            }
            if (!possible) continue;

            // Find the smallest character strictly greater than target[len]
            for (int c = target[len] - 'a' + 1; c < 26; ++c) {
                if (temp_count[c] > 0) {
                    // Pick character c for index len
                    temp_count[c]--;

                    // Reconstruct the full string
                    string res = target.substr(0, len);
                    res += (char)('a' + c);

                    // Append the remaining characters in ascending (lexicographically smallest) order
                    for (int j = 0; j < 26; ++j) {
                        while (temp_count[j] > 0) {
                            res += (char)('a' + j);
                            temp_count[j]--;
                        }
                    }
                    return res;
                }
            }
        }

        // Check if s can be completely rearranged into a string strictly greater than target
        // (Handled automatically when len reaches 0 or if all matches fail)
        return "";
    }
};
