#include <string>

class Solution {
public:
    int minChanges(std::string s) {
        int changes = 0;
        // Check adjacent pairs of characters (step by 2)
        for (int i = 0; i < s.length(); i += 2) {
            if (s[i] != s[i + 1]) {
                changes++;
            }
        }
        return changes;
    }
};
