#include <bits/stdc++.h>
using namespace std;

class Solution {
public:
    bool asteroidsDestroyed(int mass, vector<int>& asteroids) {
        sort(asteroids.begin(), asteroids.end());
        long long planetMass = mass;  // use long long to avoid overflow
        for (int asteroid : asteroids) {
            if (planetMass >= asteroid) {
                planetMass += asteroid;
            } else {
                return false;
            }
        }
        return true;
    }
};
