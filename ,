#include <vector>
#include <algorithm>
#include <numeric>

class Solution {
public:
    int minMoves(std::vector<int>& nums) {
        int max_val = *std::max_element(nums.begin(), nums.end());
        int total_moves = 0;
        for (int x : nums) {
            total_moves += (max_val - x);
        }
        return total_moves;
    }
};
