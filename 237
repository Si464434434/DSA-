#include <string>
#include <vector>
#include <algorithm>

class Solution {
public:
    int maximumLengthSubstring(std::string s) {
        int left = 0, right = 0;
        int max_len = 0;
        std::vector<int> count(26, 0);

        while (right < s.length()) {
            count[s[right] - 'a']++;

            // If any character count exceeds 2, shrink the window from the left
            while (count[s[right] - 'a'] > 2) {
                count[s[left] - 'a']--;
                left++;
            }

            max_len = std::max(max_len, right - left + 1);
            right++;
        }

        return max_len;
    }
};
