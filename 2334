#include <algorithm>
#include <vector>

using namespace std;

class Solution {
public:
    int minimizeSum(vector<int>& nums) {
        int n = static_cast<int>(nums.size());
        if (n <= 3) {
            return 0;
        }

        sort(nums.begin(), nums.end());

        // 1. Change two largest elements
        int diff1 = nums[n - 3] - nums[0];
        // 2. Change two smallest elements
        int diff2 = nums[n - 1] - nums[2];
        // 3. Change one smallest and one largest element
        int diff3 = nums[n - 2] - nums[1];

        return min({diff1, diff2, diff3});
    }
};
