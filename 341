class Solution {
public:
    bool canAliceWin(int n) {
        if (n < 10) {
            return false;
        }

        int stones = n - 10;
        int nextRemove = 9;
        bool aliceWins = true;

        while (stones >= nextRemove) {
            stones -= nextRemove;
            nextRemove--;
            aliceWins = !aliceWins;
        }

        return aliceWins;
    }
};
