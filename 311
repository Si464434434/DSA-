class Solution {
public:
    vector<string> createGrid(int m, int n) {
        // Initialize an m x n grid filled with obstacles ('#')
        vector<string> grid(m, string(n, '#'));
        
        // Mark the first row as free cells ('.')
        for (int j = 0; j < n; ++j) {
            grid[0][j] = '.';
        }
        
        // Mark the last column as free cells ('.')
        for (int i = 0; i < m; ++i) {
            grid[i][n - 1] = '.';
        }
        
        return grid;
    }
};
